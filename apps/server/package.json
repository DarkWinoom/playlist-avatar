{
  "name": "@playlist-avatar/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@playlist-avatar/contracts": "workspace:*",
    "hono": "4.13.12",
    "@hono/node-server": "2.1.3"
  }
}
